{
    "name": "tinymce-multicloud-plugin",
    "version": "0.1.0",
    "description": "TinyMCE plugin for picking and inserting assets from multiple cloud providers.",
    "type": "module",
    "main": "dist/index.global.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "docs:api": "typedoc",
        "pages:prepare": "node scripts/prepare-pages-selfhost.mjs",
        "pages:build": "npm run build && npm run docs:api && npm run pages:prepare"
    },
    "keywords": [
        "tinymce",
        "plugin",
        "google-drive",
        "onedrive",
        "dropbox",
        "bayerncloud",
        "cloud"
    ],
    "author": "",
    "license": "MIT",
    "peerDependencies": {
        "tinymce": ">=6"
    },
    "peerDependenciesMeta": {
        "tinymce": {
            "optional": true
        }
    },
    "dependencies": {
        "xdbc": "^1.0.217",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.3.0",
        "tinymce": "^7",
        "ts-jest": "^29.2.5",
        "tsup": "^8.2.4",
        "typedoc": "^0.28.19",
        "typescript": "^5.6.3"
    }
}
