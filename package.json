{
    "name": "@waxcode/tinymce-multicloud-plugin",
    "version": "0.1.0",
    "description": "TinyMCE plugin for picking and inserting assets from multiple cloud providers.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "docs:api": "typedoc",
        "pages:prepare": "node scripts/prepare-pages-selfhost.mjs",
        "pages:build": "npm run build && npm run docs:api && npm run pages:prepare",
        "docs:pages": "npm run build && npm run docs:api && node scripts/prepare-docs-pages.mjs",
        "changelog": "node scripts/generate-changelog.mjs",
        "changelog:full": "node scripts/generate-changelog.mjs --all"
    },
    "keywords": [
        "tinymce",
        "plugin",
        "google-drive",
        "onedrive",
        "dropbox",
        "bayerncloud",
        "cloud"
    ],
    "author": "Callari, Salvatore",
    "license": "MIT",
    "peerDependencies": {
        "tinymce": ">=6"
    },
    "peerDependenciesMeta": {
        "tinymce": {
            "optional": true
        }
    },
    "dependencies": {
        "xdbc": "^1.0.217",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "conventional-changelog": "^7.2.0",
        "conventional-changelog-angular": "^8.3.1",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^30.3.0",
        "tinymce": "^7",
        "ts-jest": "^29.2.5",
        "tsup": "^8.2.4",
        "typedoc": "^0.28.19",
        "typescript": "^5.6.3"
    }
}
