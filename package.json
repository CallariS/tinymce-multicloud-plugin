{
    "name": "tinymce-multicloud-plugin",
    "version": "0.1.0",
    "description": "TinyMCE plugin for picking and inserting assets from multiple cloud providers.",
    "type": "module",
    "main": "dist/index.global.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup src/index.ts --dts --format iife --global-name TinyMceMultiCloudPlugin --out-dir dist --clean --minify",
        "dev": "tsup src/index.ts --dts --format iife --global-name TinyMceMultiCloudPlugin --out-dir dist --watch",
        "typecheck": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "pages:prepare": "node scripts/prepare-pages-selfhost.mjs",
        "pages:build": "npm run build && npm run pages:prepare"
    },
    "keywords": [
        "tinymce",
        "plugin",
        "google-drive",
        "onedrive",
        "dropbox",
        "bayerncloud",
        "cloud"
    ],
    "author": "",
    "license": "MIT",
    "peerDependencies": {
        "tinymce": ">=6"
    },
    "dependencies": {
        "xdbc": "^1.0.217",
        "zod": "^3.25.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.14",
        "@types/node": "^22.0.0",
        "jest": "^29.7.0",
        "tinymce": "^6.8.6",
        "ts-jest": "^29.2.5",
        "tsup": "^8.2.4",
        "typescript": "^5.6.3"
    }
}
